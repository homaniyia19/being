From 32192337791fd8b9fd719c1c76a08417242051df Mon Sep 17 00:00:00 2001
From: being <being@meow-run2>
Date: Thu, 29 Oct 2026 16:22:40 +0100
Subject: [PATCH] Remove the dummy backend's dependency on pytest

Fixes #2290.
---
 changes/2290.bugfix.md        |  1 +
 core/tests/test_import.py     | 18 ++++++++++++++++++
 dummy/pyproject.toml          |  1 -
 dummy/src/toga_dummy/utils.py | 23 +++++++++++++----------
 4 files changed, 32 insertions(+), 11 deletions(-)
 create mode 100644 changes/2290.bugfix.md

diff --git a/changes/2290.bugfix.md b/changes/2290.bugfix.md
new file mode 100644
index 0000000..21de2d5
--- /dev/null
+++ b/changes/2290.bugfix.md
@@ -0,0 +1 @@
+The dummy backend no longer requires pytest to be installed.
diff --git a/core/tests/test_import.py b/core/tests/test_import.py
index ee10c77..4c47f54 100644
--- a/core/tests/test_import.py
+++ b/core/tests/test_import.py
@@ -1,3 +1,4 @@
+import subprocess
 import sys
 
 import pytest
@@ -36,3 +37,20 @@ def test_lazy_fail():
         AttributeError, match="module 'toga' has no attribute 'nonexistent'"
     ):
         _ = toga.nonexistent
+
+
+def test_dummy_backend_without_pytest():
+    """The dummy backend can be imported when pytest isn't installed."""
+    # A `None` entry in sys.modules makes any import of that module fail, which
+    # simulates an environment where pytest isn't installed.
+    result = subprocess.run(
+        [
+            sys.executable,
+            "-c",
+            "import sys; sys.modules['pytest'] = None; import toga_dummy.factory",
+        ],
+        check=False,
+        capture_output=True,
+        text=True,
+    )
+    assert result.returncode == 0, result.stderr
diff --git a/dummy/pyproject.toml b/dummy/pyproject.toml
index 5d798df..ef90982 100644
--- a/dummy/pyproject.toml
+++ b/dummy/pyproject.toml
@@ -124,6 +124,5 @@ root = ".."
 [tool.setuptools_dynamic_dependencies]
 dependencies = [
     "pillow >= 9.2.0",
-    "pytest >= 7.2.0",
     "toga-core == {version}",
 ]
diff --git a/dummy/src/toga_dummy/utils.py b/dummy/src/toga_dummy/utils.py
index 6629d8b..00dae6e 100644
--- a/dummy/src/toga_dummy/utils.py
+++ b/dummy/src/toga_dummy/utils.py
@@ -1,7 +1,6 @@
